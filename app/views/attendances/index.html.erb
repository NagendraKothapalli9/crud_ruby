<div class=" bg-dark text-white pt-2 vh-100">
<h3 class="text-center mt-3"><%= @student.name %></h3>
<h4 class="text-center">Email : <%= @student.email %></h4>
<h4 class="text-center">Age : <%= @student.age %></h4>
<div>
<%= link_to 'Back', school_path(@student.school), class:"btn btn-danger text-white ms-5" %>
<%= link_to "Add Attendance",
    new_student_attendance_path(@student),
    class: "btn btn-success float-end me-5" %>
</div>
<div class="table-responsive mt-2 mx-5" style="max-height: 385px; ">

    <table class="table table-striped table-hover table-bordered text-center position-relative">

      <thead class="position-sticky top-0">
    <tr>
      <th>Date</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @attendances.each do |attendance| %>
      <tr>
        <td><%= attendance.date %></td>
        <td><%= attendance.status %></td>
        <td>
          <%= link_to "Edit", edit_student_attendance_path(@student, attendance), class: "btn btn-outline-success btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>
