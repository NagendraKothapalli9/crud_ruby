<div class="text-center bg-dark text-white pt-5 align-items-center vh-100">
<h3 class="text-center mt-5">Name: <%= @student.name %></h3>
<div class="text-center">
<%= form_with model: [@student, @attendance] do |form| %>

  <div>
    <%= form.label :date,"Date :",class:"fs-5 mt-3" %>
    <%= form.date_field :date %>
  </div>

  <div>
    <%= form.label :status,"Status :",class:"fs-5 mt-3" %>

    <%= form.select :status,
        ["present", "absent"],
        {} %>
  </div>

  <div class="mt-3">
    <%= form.submit "Update",
        class: "btn btn-warning" %>
  </div>

<% end %>
</div>

<div class= "justify-content-center text-center mt-2">
  <%= link_to "Back",student_attendances_path(@student),class: "btn btn-danger mt-2 justify-content-center" %>
</div>