<div class="text-center bg-dark text-white pt-3 align-items-center vh-100">

  <h3 class="text-center mt-5">
    Name: <%= @student.name %>
  </h3>

  <div class="text-center">

    <%= form_with model: [@student, @attendance] do |form| %>

      <% if @attendance.errors.any? %>
        <% @attendance.errors.full_messages.each do |message| %>
          <p class="text-danger text-center">
            <%= message %>
          </p>
        <% end %>
      <% end %>

      <div>
        <%= form.label :date, "Date :", class: "fs-5 mt-3" %>

        <%= form.date_field :date,
            value: (@attendance.date || Date.today) %>
      </div>

      <div>
        <%= form.label :status, "Status :", class: "fs-5 mt-3" %>

        <%= form.select :status,
            ["present", "absent"],
            { prompt: "Select Status" } %>
      </div>

      <div>
        <%= form.submit "Save Attendance",
            class: "btn btn-success mt-3" %>
      </div>

    <% end %>

    <div class="justify-content-center text-center mt-2">
      <%= link_to "Back",
          student_attendances_path(@student),
          class: "btn btn-danger mt-2 justify-content-center" %>
    </div>

  </div>

</div>