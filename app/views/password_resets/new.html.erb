<div class="container-fluid bg-dark vh-100 text-white d-flex justify-content-center align-items-center">
<div class="container mb-5 " style="max-width: 400px;">
  <h3 class="mb-4">Forgot Password</h3>

  <%= form_with(url: password_resets_path, local: true) do |f| %>
    <div class="mb-3">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, class: "form-control", required: true %>
    </div>

    <div class="d-grid gap-2 mb-3">
      <%= f.submit "Send OTP", class: "btn btn-success" %>
    </div>
  <% end %>

  <div class="text-center">
    <%= link_to "Back to Login", login_path, class: "text-decoration-none text-white" %>
  </div>
</div>
</div>