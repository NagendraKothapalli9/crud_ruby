<div class="container-fluid bg-black vh-100">
<div class="container justify-content-center pt-5 text-white" style="max-width: 400px;">
  <h4>Verify OTP & Reset Password</h4>

  <%= form_with(model: @admin, url: password_reset_path(params[:id]), method: :patch, local: true) do |f| %>
    <% if @admin.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @admin.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3 mt-5">
      <%= f.label :otp_code, "Enter 6-digit OTP", class: "form-label" %>
      <%= f.text_field :otp_code, class: "form-control", maxlength: 6, required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :password, "New Password", class: "form-label" %>
      <%= f.password_field :password, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :password_confirmation, "Confirm New Password", class: "form-label" %>
      <%= f.password_field :password_confirmation, class: "form-control", required: true %>
    </div>

    <div class="d-grid gap-2">
      <%= f.submit "Reset Password", class: "btn btn-success" %>
    </div>
  <% end %>
</div>
</div>