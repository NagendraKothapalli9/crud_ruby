<div class="container-fluid bg-dark  justify-content-center  text-white  pt-5 vh-100">

<div class="container  bg-dark text-white" style="max-width: 400px;">


<%= form_with url: login_path, local: true do |form| %>
  <div class=" mt-5 pt-5">
    <%= form.label :email,class: "form-label" %><br>
    <%= form.email_field :email,class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= form.label :password,class: "form-label" %><br>
    <%= form.password_field :password,class: "form-control" %>
  </div>

  <div class="d-grid mt-4">
    <%= form.submit "Login",class:"btn btn-success" %>
  </div>

  <div class="text-center mt-4">
     <%= link_to "Sign up here", signup_path, class:"text-white text-decoration-none" %>
  </div>

  <div class="text-center mt-3">
   <%= link_to "Forgot password?", new_password_reset_path, class: "text-white text-decoration-none" %>
  </div>
<% end %>
</div>
</div>