<div class="container-fluid bg-dark  justify-content-center text-white text-center pt-5 vh-100">

<h2>Student Details</h2>

<card class="card  bg-dark text-white mt-5 mx-auto fs-4" style="width: 30rem; border: 2px solid white;">
<div class="card-body ">
<p>
  <strong>Name:</strong>
  <%= @student.name  %>
</p>

<p>
  <strong>Email:</strong>
  <%= @student.email %>
</p>

<p>
  <strong>Age:</strong>
  <%= @student.age %>
</p>

<p>
  <strong>Course:</strong>
  <%= @student.course %>
</p>

<%= link_to "View Attendance", student_attendances_path(@student), class:"btn btn-white bg-white text-dark" %>
</div>
</div>