<div class="container-fluid bg-dark justify-content-center text-white pt-2 vh-100">
    <p class="float-end">
        <%= link_to 'Logout', logout_path, data: { turbo_method: :delete }, class:" text-decoration-none fs-5 text-danger pe-5" %>
    </p>
    
   
    <div class="text-center mb-1">
      <% if @student.profile_picture.attached? %>
        <%= image_tag @student.profile_picture, width: 60, height: 60, class: "rounded-circle border border-white shadow ms-5 " , style: "object-fit: cover;" %>
      <% else %>
        <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center text-white shadow" style="width: 120px; height: 120px; font-size: 24px;">
          No Pic
        </div>
      <% end %>
    </div>

    <h3 class="text-center mb-2 me-5"><%= @student.name %></h3>


    <div class="text-center mb-4">
      <%= form_with(model: @student, local: true, html: { multipart: true, class: "d-inline-flex align-items-center gap-2" }) do |form| %>
        <div class="form-group">
          <%= form.file_field :profile_picture, class: "form-control form-control-sm bg-secondary text-white" %>
        </div>
        <div>
          <%= form.submit "Upload", class: "btn btn-sm btn-primary" %>
        </div>
      <% end %>
    </div>

    <div class="row">
    <div class= "col-6 text-center">
    <p class="fs-5"><strong>Email:</strong> <%= @student.email %></p>
    <p class="fs-5"><strong>Age:</strong> <%= @student.age %></p>
    <p class="fs-5"><strong>Course:</strong> <%= @student.course %></p>
    </div>
    <div class= "col-6 text-center">
    <p class="fs-5"><strong>Total Days:</strong> <%= @student.attendances.count %></p>
    <p class="fs-5"><strong>Present Days:</strong> <%= @student.attendances.where(status: "present").count %></p>
    <p class="fs-5"><strong>Absent Days:</strong> <%= @student.attendances.where(status: "absent").count %></p>
    </div>
    </div>
    
    <div class="table-responsive mt-2 d-flex justify-content-center" style="max-height: 385px; ">
        <table class="table table-striped table-hover table-bordered text-center position-relative w-75">

      <thead class="position-sticky top-0">
    <tr>
      <th>Date</th>
      <th>Status</th>
    </tr>
  </thead>

  <tbody>
    <% @attendances.each do |attendance| %>
      <tr>
        <td><%= attendance.date %></td>
        <td><%= attendance.status %></td>
      </tr>
    <% end %>
  </tbody>
</table> 
</div>   
</div>